# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

# --- Application ---
APP_NAME=Real-Estate Consultant API
APP_ENV=local
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/realestate
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Auth / JWT (infrastructure only in this phase; not yet in use) ---
# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-32+-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma-separated, no wildcard on authenticated routes) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_DOCUMENTS_DIR=storage/documents
STORAGE_PROVIDER=s3
STORAGE_BUCKET=realestate-documents
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=15
MAX_DOCUMENT_SIZE_MB=15

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- SMTP / Email Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@redconsultant.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Reliability & Resilience (Phase 15) ---
EXTERNAL_REQUEST_TIMEOUT=10
IDEMPOTENCY_EXPIRE_HOURS=24
